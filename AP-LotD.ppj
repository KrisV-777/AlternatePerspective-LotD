<?xml version='1.0'?><!-- Game is either sse, tesv, or fo4 -->
<PapyrusProject xmlns="PapyrusProject.xsd" 
    Flags="TESV_Papyrus_Flags.flg" 
    Game="sse" 
    Output="Scripts" 
    Optimize="true" 
    Anonymize="true" 
    Zip="true">
    <Variables>
        <Variable Name="ModName" Value="AlternatePerspective + LotD"/>
        <Variable Name="ThisProject" Value="."/>
        <Variable Name="patches" Value=".\patches"/>
        <Variable Name="Rel" Value=".\.releases"/>
        <Variable Name="MO2" Value=".."/>
        <Variable Name="Ver" Value="1.0.2"/>
    </Variables>
    <Imports>
        <Import>@ThisProject\Source\Scripts</Import>
        <Import>@MO2\Creation Kit\Source\Scripts</Import>
        <!-- Ressources -->
        <Import>@MO2\Relic Hunter- Guildmaster Start\Scripts\Source</Import>
        <Import>@MO2\Legacy of the Dragonborn\Source\Scripts</Import>
        <Import>@MO2\Alternate Perspective\Source\Scripts</Import>
        <Import>@MO2\JContainers SE\Source\Scripts</Import>
        <!-- Base Game -->
        <Import>C:\Program Files (x86)\Steam\steamapps\common\Skyrim Special Edition\Data\Source\Scripts</Import>
    </Imports>
    <Folders>
        <Folder>@ThisProject\Source\Scripts</Folder>
    </Folders>
    <ZipFiles Output="@Rel">
        <!-- Main Files -->
        <ZipFile Name="@ModName @Ver" RootDir="@ThisProject" Compression="deflate">
            <Include>LOTD_AP.esp</Include>
        	<Include>Scripts\dbm_lalstartscript.pex</Include>
        	<Include>Scripts\dbm_qf_dbm_relichunterqst_063f14fc.pex</Include>
        	<Include>Source\Scripts\dbm_lalstartscript.psc</Include>
        	<Include>Source\Scripts\dbm_qf_dbm_relichunterqst_063f14fc.psc</Include>
        </ZipFile>
        <ZipFile Name="@ModName @Ver Relic Hunter" RootDir="@ThisProject" Compression="deflate">
        	<Include>DBM_RelicHunter.esp</Include>
            <Include>Scripts\dbm__qf_dbm_relichunterstartq_08005909.pex</Include>
            <Include>Source\Scripts\dbm__qf_dbm_relichunterstartq_08005909.psc</Include>
            <Include>SKSE\AlternatePerspective\LOTDRelicHunter.json</Include>
        </ZipFile>
    </ZipFiles>
</PapyrusProject>